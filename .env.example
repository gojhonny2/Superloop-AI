# ================================================================
# SUPERLOOP MISSION CONTROL CONFIGURATION
# Alpha defaults for the manager-led build/test loop

# --- [A] CORE API KEYS ---
# Required for native support (openai:..., anthropic:..., gemini:...)
OPENAI_API_KEY="your-openai-key"
ANTHROPIC_API_KEY="your-anthropic-key"
GEMINI_API_KEY="your-gemini-key"

# --- [B] UNIVERSAL PROVIDERS ---
# Use these for aggregator/proxy endpoints
OPENROUTER_API_KEY="your-openrouter-key"
KILO_API_KEY="your-kilo-key"
DEEPSEEK_API_KEY="your-deepseek-key"
GROQ_API_KEY="your-groq-key"
MISTRAL_API_KEY="your-mistral-key"
TOGETHER_API_KEY="your-together-key"

# --- [C] SWARM ROLES ---
# Assign specific models to the Manager and Specialist roles.
# Format: provider:model_name (or custom:model_name:url:env_key)

# 1. The Manager (Lead Scientist)
# Recommended: Reasoning-heavy models (e.g., Gemini Pro, GPT-4o, Claude 3 Opus)
SUPERLOOP_MANAGER="gemini:gemini-1.5-pro"

# 2. The Specialists (The Swarm)
# Recommended: Exactly 2 models for a 3-model TOTAL swarm (The "Golden Ratio").
# This prevents the Manager from hallucinating during comparative synthesis.
SUPERLOOP_SPECIALISTS="openai:gpt-4o,anthropic:claude-3-5-sonnet-20240620"

# --- [D] DASHBOARD / CLI DEFAULTS ---
# These values are loaded into the dashboard when you launch it from the CLI.
# They also act as defaults for headless runs unless you override them with flags.
SUPERLOOP_WORKSPACE="."
SUPERLOOP_DATA_PATH=""
SUPERLOOP_GOAL=""
SUPERLOOP_JUDGE_BRIEF=""
SUPERLOOP_OPERATOR_BRIEF=""
SUPERLOOP_TARGET_SCORE="0.8"
SUPERLOOP_MAX_ITERS="5"
SUPERLOOP_RESUME="false"

# --- [E] CUSTOM / LOCAL LLMS ---
# For local Ollama or private gateways:
# Example Descriptor: custom:my-model:http://localhost:11434/v1:MY_LOCAL_KEY
MY_LOCAL_KEY="not-real-key"
